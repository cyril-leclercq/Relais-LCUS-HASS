# ============================================================================
# Docker Compose - Home Assistant + Matter Server + Volet Relais USB
# ============================================================================
# Configuration de production testée avec:
# - Home Assistant 2026.4.4
# - Matter Server (stable)
# - Module relais USB 2 canaux pour volet roulant
#
# IMPORTANT: Assurez-vous que le port USB est correctement mappé dans la
# section devices du conteneur homeassistant.
# ============================================================================

services:
  # --------------------------------------------------------------------------
  # Matter Server - Protocole Matter pour appareils connectés
  # --------------------------------------------------------------------------
  matter-server:
    image: ghcr.io/home-assistant-libs/python-matter-server:stable
    container_name: matter-server
    restart: unless-stopped
    network_mode: host  # Nécessaire pour la découverte mDNS
    security_opt:
      - apparmor:unconfined  # Requis pour l'accès Bluetooth/mDNS
    volumes:
      - /opt/docker/matter/data:/data
      - /run/dbus:/run/dbus:ro  # Indispensable pour l'appairage Nest Hub via Bluetooth

  # --------------------------------------------------------------------------
  # Home Assistant - Intégration domotique principale
  # --------------------------------------------------------------------------
  homeassistant:
    image: ghcr.io/home-assistant/home-assistant:2026.4.4
    container_name: homeassistant
    restart: unless-stopped
    privileged: true  # Donne accès aux périphériques USB
    network_mode: host  # Requis pour la découverte réseau et mDNS
    
    volumes:
      - /opt/docker/hass/config:/config
      - /etc/localtime:/etc/localtime:ro
    
    # ========================================================================
    # ⚠️  CONFIGURATION USB POUR LE MODULE RELAIS VOLET ROULANT
    # ========================================================================
    # MÉTHODE RECOMMANDÉE: Utiliser /dev/serial/by-id/
    # - Identifiant stable créé automatiquement par le système
    # - Fonctionne même si le port change (ttyUSB0 → ttyUSB1)
    # - Aucune règle udev personnalisée nécessaire
    # ========================================================================
    
    devices:
      # 1. Trouver votre device: ls -l /dev/serial/by-id/
      # 2. Remplacer par votre ID (exemple: usb-1a86_USB_Serial-if00-port0)
      # 3. Docker crée automatiquement /dev/lcus_relay dans le conteneur
      - /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0:/dev/lcus_relay
    
    depends_on:
      - matter-server

# ============================================================================
# DÉPLOIEMENT
# ============================================================================
# Docker Compose (standalone):
#   docker-compose up -d
#   docker-compose logs -f homeassistant
#
# Docker Swarm:
#   docker stack deploy -c docker-compose.yaml hass-stack
#   docker service logs -f hass-stack_homeassistant
#
# Redéployer après modification:
#   docker-compose up -d --force-recreate
#   docker stack deploy -c docker-compose.yaml hass-stack --force
# ============================================================================

# ============================================================================
# VÉRIFICATION DU PORT USB DANS LE CONTENEUR
# ============================================================================
# Vérifier que le port USB est bien accessible:
#   docker exec homeassistant ls -l /dev/ttyUSB0
#   docker exec homeassistant python3 -c "import serial; print(serial.Serial('/dev/ttyUSB0', 9600))"
#
# Si erreur "Permission denied":
#   sudo chmod 666 /dev/ttyUSB0
#
# Si erreur "No such file":
#   Vérifier le mapping dans la section devices ci-dessus
# ============================================================================

